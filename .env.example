# LLM提供商配置
# 可选值: openai, ollama
LLM_PROVIDER=ollama

# OpenAI配置（当 LLM_PROVIDER=openai 时使用）
OPENAI_API_KEY=your-api-key-here
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_BASE_URL=https://api.openai.com/v1

# Ollama LLM配置（当 LLM_PROVIDER=ollama 时使用）
OLLAMA_MODEL=Lusizo/qwen2.5-7b-instruct-1m:latest
OLLAMA_BASE_URL=http://localhost:11434

# Embedding提供商配置
# 可选值: sentence_transformers, ollama
EMB_PROVIDER=ollama

# Sentence-Transformers Embedding配置
EMB_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMB_DEVICE=cpu

# Ollama Embedding配置
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ReRanker配置
RET_RERANKER_ENABLED=true
RET_RERANKER_PROVIDER=cohere
RET_RERANKER_MODEL=rerank-multilingual-v3.0

# Cohere API Key (从 https://dashboard.cohere.com/api-keys 获取)
COHERE_API_KEY=your-cohere-api-key-here

# 文档处理配置
DOC_CHUNK_SIZE=800
DOC_CHUNK_OVERLAP=160

# 生成参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# 调试模式
DEBUG=false
LOG_LEVEL=INFO
