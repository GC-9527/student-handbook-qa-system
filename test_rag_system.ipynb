  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import time\n",
    "\n",
    "try:\n",
    "    rag_engine = RAGEngine()\n",
    "    \n",
    "    queries = [\n",
    "        \"学生请假需要什么流程？\",\n",
    "        \"考试作弊会有什么后果？\",\n",
    "        \"奖学金评选标准是什么？\",\n",
    "        \"图书馆开放时间？\",\n",
    "        \"如何申请转专业？\"\n",
    "    ]\n",
    "    \n",
    "    print(\"性能测试结果:\\n\")\n",
    "    print(f\"{'查询':<30} {'耗时(秒)':<10} {'状态':<10}\")\n",
    "    print(\"-\" * 60)\n",
    "    \n",
    "    total_time = 0\n",
    "    for query in queries:\n",
    "        start = time.time()\n",
    "        try:\n",
    "            result = rag_engine.query(query)\n",
    "            elapsed = time.time() - start\n",
    "            total_time += elapsed\n",
    "            status = \"✓ 成功\"\n",
    "        except Exception as e:\n",
    "            elapsed = time.time() - start\n",
    "            total_time += elapsed\n",
    "            status = f\"✗ 失败\"\n",
    "        \n",
    "        query_short = query[:25] + \"...\" if len(query) > 25 else query\n",
    "        print(f\"{query_short:<30} {elapsed:<10.2f} {status:<10}\")\n",
    "    \n",
    "    print(\"-\" * 60)\n",
    "    print(f\"{'总计':<30} {total_time:<10.2f}\")\n",
    "    print(f\"{'平均':<30} {total_time/len(queries):<10.2f}\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"✗ 性能测试失败: {e}\")"
   ]
  },
