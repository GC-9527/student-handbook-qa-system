   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6.1 构建知识库"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 构建知识库（如果还没有）\n",
    "import os\n",
    "\n",
    "vector_store_path = \"vector_store/faiss_index.bin\"\n",
    "\n",
    "if not os.path.exists(vector_store_path):\n",
    "    print(\"正在构建知识库...\")\n",
    "    \n",
    "    # 初始化组件\n",
    "    pdf_parser = PDFParser()\n",
    "    embedding_model = OllamaEmbedding()\n",
    "    retriever = FaissRetriever(embedding_model=embedding_model)\n",
    "    \n",
    "    # 解析 PDF\n",
    "    documents = pdf_parser.parse_directory(\"data\")\n",
    "    print(f\"解析了 {len(documents)} 个文档\")\n",
    "    \n",
    "    # 构建索引\n",
    "    retriever.build_index(documents)\n",
    "    print(f\"✓ 知识库构建完成\")\n",
    "else:\n",
    "    print(\"✓ 知识库已存在\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6.2 执行 RAG 查询"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 初始化 RAG 引擎\n",
    "try:\n",
    "    rag_engine = RAGEngine()\n",
    "    print(\"✓ RAG 引擎初始化成功\\n\")\n",
    "    \n",
    "    # 测试查询\n",
    "    test_queries = [\n",
    "        \"学生请假需要什么流程？\",\n",
    "        \"考试作弊会有什么后果？\",\n",
    "        \"奖学金评选标准是什么？\"\n",
    "    ]\n",
    "    \n",
    "    for query in test_queries:\n",
    "        print(f\"\\n{'='*60}\")\n",
    "        print(f\"查询: {query}\")\n",
    "        print(f\"{'='*60}\")\n",
    "        \n",
    "        result = rag_engine.query(query)\n",
    "        \n",
    "        print(f\"\\n回答:\\n{result.answer}\\n\")\n",
    "        \n",
    "        print(\"引用来源:\")\n",
    "        for i, citation in enumerate(result.citations[:3], 1):\n",
    "            print(f\"  [{i}] {citation.source}, 第{citation.page}页\")\n",
    "            print(f\"      {citation.content[:100]}...\")\n",
    "        \n",
    "        if result.retrieval_info:\n",
    "            info = result.retrieval_info\n",
    "            print(f\"\\n检索信息:\")\n",
    "            print(f\"  粗排召回: {info.get('initial_k', 'N/A')} 条\")\n",
    "            print(f\"  精排后: {info.get('final_k', 'N/A')} 条\")\n",
    "            if 'rerank_scores' in info:\n",
    "                scores = info['rerank_scores']\n",
    "                print(f\"  重排序分数: {scores}\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"✗ RAG 查询失败: {e}\")\n",
    "    import traceback\n",
    "    traceback.print_exc()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. 重排序效果对比"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 对比重排序前后的结果\n",
    "try:\n",
    "    query = \"学生请假流程\"\n",
    "    print(f\"查询: {query}\\n\")\n",
    "    \n",
    "    # 获取 Embedding 模型和 Retriever\n",
    "    from student_rag.core.embeddings import OllamaEmbedding\n",
    "    from student_rag.core.retriever import FaissRetriever\n",
    "    from student_rag.core.reranker import FlashRankReranker\n",
    "    \n",
    "    embedding_model = OllamaEmbedding()\n",
    "    retriever = FaissRetriever(embedding_model=embedding_model)\n",
    "    \n",
    "    # 加载索引\n",
    "    retriever.load_index(\"vector_store/faiss_index.bin\")\n",
    "    \n",
    "    # 1. 向量检索（粗排）\n",
    "    print(\"=" * 60)\n",
    "    print(\"【阶段1】向量检索结果（Top 5）\")\n",
    "    print(\"=" * 60)\n",
    "    \n",
    "    initial_results = retriever.search(query, top_k=5)\n",
    "    for i, doc in enumerate(initial_results, 1):\n",
    "        score = doc.metadata.get('score', 0)\n",
    "        print(f\"\\n{i}. 相似度: {score:.4f}\")\n",
    "        print(f\"   来源: {doc.source}, 第{doc.page}页\")\n",
    "        print(f\"   内容: {doc.content[:150]}...\")\n",
    "    \n",
    "    # 2. 重排序\n",
    "    print(\"\\n\" + \"=\" * 60)\n",
    "    print(\"【阶段2】FlashRank 重排序结果（Top 3）\")\n",
    "    print(\"=\" * 60)\n",
    "    \n",
    "    reranker = FlashRankReranker()\n",
    "    passages = [doc.content for doc in initial_results]\n",
    "    scores = reranker.rerank(query, passages, top_k=3)\n",
    "    \n",
    "    # 按重排序分数排序\n",
    "    ranked_indices = sorted(range(len(scores)), key=lambda i: scores[i], reverse=True)[:3]\n",
    "    \n",
    "    for rank, idx in enumerate(ranked_indices, 1):\n",
    "        doc = initial_results[idx]\n",
    "        old_rank = idx + 1\n",
    "        rerank_score = scores[idx]\n",
    "        print(f\"\\n{rank}. 重排序分数: {rerank_score:.4f} (原排名: {old_rank})\")\n",
    "        print(f\"   来源: {doc.source}, 第{doc.page}页\")\n",
    "        print(f\"   内容: {doc.content[:150]}...\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"✗ 对比测试失败: {e}\")\n",
    "    import traceback\n",
    "    traceback.print_exc()"
   ]
  },
