  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 测试 Ollama 连接"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "\n",
    "OLLAMA_HOST = \"http://localhost:11434\"\n",
    "\n",
    "# 测试 Ollama 服务\n",
    "try:\n",
    "    response = requests.get(f\"{OLLAMA_HOST}/api/tags\", timeout=5)\n",
    "    if response.status_code == 200:\n",
    "        models = response.json().get('models', [])\n",
    "        print(\"✓ Ollama 服务运行正常\")\n",
    "        print(f\"\\n已安装的模型 ({len(models)} 个):\")\n",
    "        for model in models:\n",
    "            print(f\"  - {model['name']}\")\n",
    "    else:\n",
    "        print(f\"✗ Ollama 返回错误: {response.status_code}\")\n",
    "except Exception as e:\n",
    "    print(f\"✗ 无法连接到 Ollama: {e}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 测试 LLM 对话"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import requests\n",
    "import json\n",
    "\n",
    "LLM_MODEL = \"qwen2.5-7b-instruct-1m\"\n",
    "\n",
    "def test_llm(prompt):\n",
    "    \"\"\"测试 LLM 对话\"\"\"\n",
    "    try:\n",
    "        response = requests.post(\n",
    "            f\"{OLLAMA_HOST}/api/generate\",\n",
    "            json={\n",
    "                \"model\": LLM_MODEL,\n",
    "                \"prompt\": prompt,\n",
    "                \"stream\": False\n",
    "            },\n",
    "            timeout=60\n",
    "        )\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            result = response.json()\n",
    "            return result.get('response', '无响应')\n",
    "        else:\n",
    "            return f\"错误: {response.status_code} - {response.text}\"\n",
    "    except Exception as e:\n",
    "        return f\"请求失败: {e}\"\n",
    "\n",
    "# 测试简单对话\n",
    "print(\"测试 LLM 对话...\")\n",
    "response = test_llm(\"你好，请介绍一下自己\")\n",
    "print(f\"\\n响应: {response}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 测试 Embedding 模型"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "EMBEDDING_MODEL = \"nomic-embed-text\"\n",
    "\n",
    "def get_embedding(text):\n",
    "    \"\"\"获取文本的 Embedding\"\"\"\n",
    "    try:\n",
    "        response = requests.post(\n",
    "            f\"{OLLAMA_HOST}/api/embeddings\",\n",
    "            json={\n",
    "                \"model\": EMBEDDING_MODEL,\n",
    "                \"prompt\": text\n",
    "            },\n",
    "            timeout=30\n",
    "        )\n",
    "        \n",
    "        if response.status_code == 200:\n",
    "            result = response.json()\n",
    "            embedding = result.get('embedding', [])\n",
    "            return np.array(embedding)\n",
    "        else:\n",
    "            print(f\"错误: {response.status_code} - {response.text}\")\n",
    "            return None\n",
    "    except Exception as e:\n",
    "        print(f\"请求失败: {e}\")\n",
    "        return None\n",
    "\n",
    "# 测试 Embedding\n",
    "print(\"测试 Embedding 模型...\")\n",
    "texts = [\n",
    "    \"学生请假需要提前申请\",\n",
    "    \"考试作弊会被开除学籍\",\n",
    "    \"图书馆开放时间是早上8点\"\n",
    "]\n",
    "\n",
    "embeddings = []\n",
    "for text in texts:\n",
    "    emb = get_embedding(text)\n",
    "    if emb is not None:\n",
    "        embeddings.append(emb)\n",
    "        print(f\"✓ '{text[:20]}...' -> 维度: {len(emb)}\")\n",
    "\n",
    "# 计算相似度\n",
    "if len(embeddings) >= 2:\n",
    "    from numpy.linalg import norm\n",
    "    \n",
    "    def cosine_similarity(a, b):\n",
    "        return np.dot(a, b) / (norm(a) * norm(b))\n",
    "    \n",
    "    print(f\"\\n相似度矩阵:\")\n",
    "    for i in range(len(embeddings)):\n",
    "        for j in range(len(embeddings)):\n",
    "            sim = cosine_similarity(embeddings[i], embeddings[j])\n",
    "            print(f\"  {i}-{j}: {sim:.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 测试 PDF 解析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "# 查找测试 PDF 文件\n",
    "data_dir = Path(\"data\")\n",
    "pdf_files = list(data_dir.glob(\"*.pdf\"))\n",
    "\n",
    "if pdf_files:\n",
    "    print(f\"找到 {len(pdf_files)} 个 PDF 文件:\")\n",
    "    for pdf in pdf_files:\n",
    "        print(f\"  - {pdf}\")\n",
    "    \n",
    "    # 解析第一个 PDF\n",
    "    test_pdf = pdf_files[0]\n",
    "    print(f\"\\n解析文件: {test_pdf.name}\")\n",
    "    \n",
    "    try:\n",
    "        import pdfplumber\n",
    "        with pdfplumber.open(test_pdf) as pdf:\n",
    "            print(f\"总页数: {len(pdf.pages)}\")\n",
    "            \n",
    "            # 显示前几页内容\n",
    "            for i, page in enumerate(pdf.pages[:3]):\n",
    "                text = page.extract_text() or \"\"\n",
    "                print(f\"\\n--- 第 {i+1} 页 ---\")\n",
    "                print(text[:300] + \"...\" if len(text) > 300 else text)\n",
    "    except Exception as e:\n",
    "        print(f\"解析失败: {e}\")\n",
    "else:\n",
    "    print(\"未找到 PDF 文件，请先创建示例数据\")\n",
    "    print(\"运行: python create_sample_handbook.py\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 完整 RAG 测试"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 导入项目模块\n",
    "import sys\n",
    "sys.path.insert(0, '.')\n",
